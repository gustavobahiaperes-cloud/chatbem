# Copie este arquivo para .env.local e preencha com os dados do seu projeto
# em https://cloud.livekit.io (Settings -> Keys).

LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_URL=wss://seu-projeto.livekit.cloud

# Opcional: histórico do chat (mensagens ficam 7 dias para quem entrar depois).
# Crie um banco Redis grátis em https://console.upstash.com (ou pela integração
# "Upstash for Redis" no Marketplace da Vercel, que já cria as variáveis KV_REST_API_*).
# Sem estas variáveis o chat funciona só ao vivo.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
